{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-inline-eval.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-registry-fetch.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-history-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-git-dir.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-lockfiles.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/enforce-agent-commit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/guard-overwrite.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-git-dir.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-lockfiles.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "bash .claude/skills/init-agent/init-agent.sh",
      "bash .claude/skills/init-agent/init-agent.sh *",
      "bash .claude/skills/cowlick/apply-prompt.sh",
      "bash .claude/skills/cowlick/apply-prompt.sh *",
      "bash .claude/skills/run-agent/mark-prompt-done.sh",
      "bash .claude/skills/run-agent/mark-prompt-done.sh *",
      "bash .claude/skills/run-agent/delegate-deepseek.sh",
      "bash .claude/skills/run-agent/delegate-deepseek.sh *",
      "bash .claude/skills/e2e/apply-e2e-plan.sh",
      "bash .claude/skills/e2e/apply-e2e-plan.sh *"
    ],
    "filesystem": {
      "denyWrite": [".git/hooks", ".git/config", ".env", ".env.*", ".claude"]
    },
    "network": {
      "allowLocalBinding": false,
      "allowedDomains": []
    }
  }
}
