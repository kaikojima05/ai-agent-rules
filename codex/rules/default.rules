# <repo>/.codex/rules/default.rules として配置する。
# 可逆でも未コミット内容を失う操作は都度確認し、共有履歴を変える操作は拒否する。

# distributed permission profile が保護する .codex / .agents へ書けるのは、宛先と処理を固定した
# レビュー済みスクリプトだけ。汎用の shell / cp / sed には例外を与えない。
prefix_rule(
    pattern = ["bash", ".agents/skills/init-agent/init-agent.sh", "codex"],
    decision = "allow",
    justification = "配置済みCodex設定のplaceholderを決定的スクリプトで解決します。",
)
prefix_rule(
    pattern = ["bash", ".agents/skills/cowlick/apply-prompt.sh"],
    decision = "allow",
    justification = "確認済みドラフトをdraft-prompt/から固定の.codex/prompt/へ移します。",
)
prefix_rule(
    pattern = ["bash", ".agents/skills/run-agent/mark-prompt-done.sh"],
    decision = "allow",
    justification = "実装済みの設計書を固定の.codex/prompt/.prompt.md上で[x]に倒します。",
)
prefix_rule(
    pattern = ["bash", ".agents/skills/run-agent/delegate-deepseek.sh"],
    decision = "allow",
    justification = "予算・ZDR・編集先を固定検証してDeepSeekを隔離worktreeで実行します。",
)
prefix_rule(
    pattern = ["bash", ".agents/skills/run-agent/delegate-deepseek.sh", "smoke"],
    decision = "prompt",
    justification = "従量課金の下位モデルへhelloを送るsmoke testを実行するか確認します。",
    match = [
        "bash .agents/skills/run-agent/delegate-deepseek.sh smoke",
    ],
    not_match = [
        "bash .agents/skills/run-agent/delegate-deepseek.sh research task-id spec.md",
    ],
)
prefix_rule(
    pattern = ["bash", ".agents/skills/e2e/apply-e2e-plan.sh"],
    decision = "allow",
    justification = "確認済み計画を固定の.codex/e2e/.e2e.mdへ反映します。",
)
prefix_rule(
    pattern = ["bash", ".agents/skills/rebase-squash/rebase-squash.sh"],
    decision = "prompt",
    justification = "未push履歴の変更計画とbackup作成条件を確認します。",
)

# 自動コミットは共有 hook が index とメッセージを検証することを前提に許可する。
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "共有hookが一括stageを拒否するため、対象ファイルの個別stageを許可します。",
)
prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "共有hookがstage件数・対象名・日本語メッセージを検証するため、契約準拠commitを許可します。",
)

# option無しでもfilesystemへ書くcommandは、対象を確認してから実行する。固定スクリプトは
# 上の限定allowに一致するため、内部実装のcp/mkdirまで個別承認にはならない。
prefix_rule(
    pattern = [["cp", "install", "rsync", "touch", "mkdir", "chmod", "chown", "chgrp", "ln", "patch"]],
    decision = "prompt",
    justification = "filesystemへの作成・上書き・metadata変更の対象を確認してから実行します。",
    match = [
        "cp source.txt target.txt",
        "mkdir build-output",
        "chmod +x script.sh",
    ],
    not_match = [
        "cat source.txt",
        "find src -type f -print",
    ],
)

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "削除対象と復元方法を確認してから実行します。",
)
prefix_rule(
    pattern = ["rmdir"],
    decision = "prompt",
    justification = "ディレクトリ削除前に対象を確認します。",
)
prefix_rule(
    pattern = ["unlink"],
    decision = "prompt",
    justification = "ファイルまたはリンクの削除前に対象を確認します。",
)
prefix_rule(
    pattern = ["shred"],
    decision = "prompt",
    justification = "復元困難な削除前に対象を確認します。",
)
prefix_rule(
    pattern = ["mv"],
    decision = "prompt",
    justification = "移動による上書きや参照切れがないことを確認します。",
)
prefix_rule(
    pattern = ["dd"],
    decision = "prompt",
    justification = "低水準の上書き対象を確認します。",
)
prefix_rule(
    pattern = ["truncate"],
    decision = "prompt",
    justification = "ファイル内容を失う操作なので対象を確認します。",
)
prefix_rule(
    pattern = ["tee"],
    decision = "prompt",
    justification = "出力先ファイルの上書き可否を確認します。",
)
prefix_rule(
    pattern = ["sed", "-i"],
    decision = "prompt",
    justification = "in-place編集の対象を確認します。",
)

# redirection・変数展開・wildcard・control flow を含むscriptはCodexが個別コマンドへ
# 安全に分解できないため、shell wrapper全体を確認対象にする。
prefix_rule(
    pattern = [["bash", "zsh", "sh"], ["-lc", "-c"]],
    decision = "prompt",
    justification = "静的に分解できないshell scriptの副作用を確認します。",
)

# 未コミット内容やindexを失わせる可能性があるGit操作。
prefix_rule(
    pattern = ["git", ["reset", "clean", "restore", "checkout", "switch"]],
    decision = "prompt",
    justification = "作業ツリーまたはindexへの影響を確認します。",
)

# 共有履歴への不可逆操作は禁止。
prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "pushはユーザー自身が変更内容を確認して実行してください。",
)
prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "forbidden",
    justification = "履歴の取り込みはユーザー自身が実行してください。",
)
